# =============================================================================
# DLYK CRM 环境变量模板
# -----------------------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env（.env 已被 .gitignore 排除，绝不提交）
#   2. 填写真实值
#   3. 启动后端前注入环境变量（见 README / IDE 运行配置 / docker-compose env_file）
#
# 安全背景：历史版本曾把密钥明文写在 application.yml 并随公开仓库泄露，
# 现已全部外部化。JWT_SECRET / DB_PASSWORD / REDIS_PASSWORD 三个变量
# 缺失时后端 fail-fast（启动即失败），不存在任何默认密钥。
# =============================================================================

# ---------- 数据库（必填） ----------
DB_URL=jdbc:mysql://127.0.0.1:3306/dlyk?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=<你的MySQL密码>

# ---------- Redis（必填） ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<你的Redis密码>
REDIS_DB=0

# ---------- JWT 签名密钥（必填，fail-fast） ----------
# 必须使用全新随机值（旧密钥已泄露作废）。生成命令（任选其一）：
#   openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=<在此粘贴新生成的随机密钥>

# ---------- AI 大模型（可选，不配置则AI功能不可用，其余功能正常） ----------
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=<你的模型API Key>
AI_MODEL_NAME=glm-5.2
